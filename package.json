{
  "name": "spidey-sense",
  "productName": "Spidey Sense",
  "version": "0.1.0",
  "description": "A Spider-Man themed always-on-screen system monitor: a hanging spider-web radar that tingles when your PC is in trouble.",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icons": "electron scripts/make-icons.js",
    "test": "node scripts/selftest.js",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dist-local.ps1",
    "test:unit": "node scripts/guardian-test.js && node scripts/karen-test.js"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.spidey.sense",
    "productName": "Spidey Sense",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "guardian.js",
      "karen-llm.js",
      "renderer/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spidey Sense",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Spidey-Sense-Setup-${version}.exe",
      "include": "build/installer.nsh",
      "allowElevation": false
    }
  }
}
