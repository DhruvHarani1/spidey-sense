{
  "name": "spidey-sense",
  "productName": "Spidey Sense",
  "version": "0.4.0",
  "description": "Smart, lightweight system monitoring and protection for Windows: a live radar, culprit detection, E.D.I.T.H. security posture and reversible Auto-Shield, in a Spider-Man skin.",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icons": "electron scripts/make-icons.js",
    "test": "node scripts/selftest.js",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dist-local.ps1",
    "test:unit": "node scripts/guardian-test.js && node scripts/karen-test.js && node scripts/bugle-test.js && node scripts/edith-test.js && node scripts/suits-test.js && node scripts/autostart-test.js && node scripts/updater-test.js && node scripts/help-test.js && node scripts/shield-test.js && node scripts/history-test.js",
    "docs": "node scripts/build-docs.js",
    "help": "node bin/spidey.js help"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.spidey.sense",
    "productName": "Spidey Sense",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "guardian.js",
      "edith.js",
      "renderer/**/*",
      "assets/icon.png",
      "package.json",
      "autostart.js",
      "updater.js",
      "bin/**/*",
      "help-data.js",
      "census.js",
      "shield.js"
    ],
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      },
      {
        "from": "renderer/help.html",
        "to": "help.html"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Spidey Sense",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Spidey-Sense-Setup-${version}.exe",
      "include": "build/installer.nsh",
      "allowElevation": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DhruvHarani1",
        "repo": "spidey-sense",
        "releaseType": "release"
      }
    ],
    "extraFiles": [
      {
        "from": "build/spidey.cmd",
        "to": "spidey.cmd"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "bin": {
    "spidey": "bin/spidey.js"
  }
}
